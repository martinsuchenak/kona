(* ===========================================================================
   Kona Language (コナビ) Formal Grammar Specification
   Standard: ISO/IEC 14977 Extended Backus-Naur Form (EBNF)
   =========================================================================== *)

(* --- 1. Top-Level Program / Utterance --- *)
Utterance
    = Pipeline ;

Pipeline
    = ShorthandPipeline
    | SpokenPipeline ;

ShorthandPipeline
    = PipelineStage , { ShorthandPipe , PipelineStage } ;

SpokenPipeline
    = PipelineStage , { SpokenPipe , PipelineStage } ;

ShorthandPipe
    = "|>" ;

SpokenPipe
    = "te" | "te," | "te ," ;


(* --- 2. Pipeline Stages & Execution Units --- *)
PipelineStage
    = [ ConditionalPrefix ] , ( StageBody | NestedPipeline ) , [ AlternativeBranch ] ;

NestedPipeline
    = "(" , [ Whitespace ] , Pipeline , [ Whitespace ] , ")" ;

ConditionalPrefix
    = "si" , Whitespace , Expression , ( SpokenPipe | ":" ) ;

AlternativeBranch
    = ( "ali" | ":else:" ) , Whitespace , PipelineStage ;

StageBody
    = { Element , [ Whitespace ] } ;

Element
    = GuardConstraint
    | FormatSpecifier
    | TargetReference
    | ActionExpression
    | RelativeClause
    | LiteralValue
    | Identifier ;


(* --- 3. Action Expressions & Higher-Order Modifiers --- *)
ActionExpression
    = ModifiedAction
    | BaseAction ;

ModifiedAction
    = PrefixModifier , [ "-" ] , (* BEGIN GENERATED -- edit kona.py, then run generate_artifacts.py *)

(* Terminal vocabularies below are generated from kona.py. Do not edit
   them here: edit the lexicon and regenerate. *)

