    | "suno"            (* zero/without_delay *)
    | "ve"              (* dry_run/speculative *)
    ;

FormatSpecifier
    = "difa"            (* diff *)
    | "jano"            (* json *)
    | "mesa"            (* table *)
    | "poti"            (* bullet_list *)
    | "puro"            (* plain_text *)
    ;

Particle
    = "ali"             (* else *)
    | "deko"            (* quantifier_ten *)
    | "duo"             (* quantifier_two *)
    | "fino"            (* literal_close *)
    | "ina"             (* scope_inside *)
    | "kasi"            (* causal_because *)
    | "ke"              (* relative_linker *)
    | "kito"            (* deixis_this_current *)
    | "kono"            (* conclusive_therefore *)
    | "lo"              (* logical_or *)
    | "mapo"            (* logical_and *)
    | "masi"            (* comparative_more *)
    | "muto"            (* quantifier_many *)
    | "nomi"            (* literal_open *)
    | "notori"          (* guard_prohibit *)
    | "oli"             (* quantifier_all *)
    | "pato"            (* deixis_previous_output *)
    | "pero"            (* contrast_but *)
    | "sama"            (* equative_same *)
    | "si"              (* if *)
    | "supera"          (* superlative_above *)
    | "te"              (* pipe_then *)
    | "ti"              (* topic_marker *)
    | "uni"             (* quantifier_some *)
    | "uta"             (* scope_outside *)
    | "ye"              (* affirmative_yes *)
    ;

Digit
    = "bi"              (* 8 *)
    | "du"              (* 2 *)
    | "fo"              (* 4 *)
    | "go"              (* 9 *)
    | "ke"              (* 7 *)
    | "mu"              (* 5 *)
    | "pa"              (* 1 *)
    | "sa"              (* 6 *)
    | "ti"              (* 3 *)
    | "wo"              (* 0 *)
    ;

AspectSuffix
    = "ba"              (* progressive *)
    | "sa"              (* habitual *)
    | "ta"              (* perfective *)
    ;

DerivationalSuffix
    = "kaba"            (* environment_space *)
    | "koso"            (* physical_device *)
    | "peji"            (* display_surface *)
    | "yoti"            (* specialist_role *)
    ;

