Modifier
    = "de"              (* deep/exhaustive *)
    | "dura"            (* continuous/in_progress *)
    | "futu"            (* future/scheduled *)
    | "no"              (* prohibit/guard_not *)
    | "oto"             (* autonomous/auto *)
