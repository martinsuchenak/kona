{
  "name": "kona-language",
  "displayName": "Kona Language Support",
  "description": "Language support, syntax highlighting, and snippets for the Kona functional agent language",
  "version": "0.2.1",
  "publisher": "kona-lang",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kona",
        "aliases": [
          "Kona",
          "kona"
        ],
        "extensions": [
          ".kona"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kona",
        "scopeName": "source.kona",
        "path": "./syntaxes/kona.tmLanguage.json"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "tsc -p ./"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinsuchenak/kona.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/martinsuchenak/kona/issues"
  },
  "homepage": "https://github.com/martinsuchenak/kona#readme",
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/vscode": "^1.93.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "activationEvents": [
    "onLanguage:kona"
  ]
}